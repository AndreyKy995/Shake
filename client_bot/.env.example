# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat id: запустите бота, напишите ему /myid и вставьте число сюда
OWNER_CHAT_ID=
# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Необязательно
CLAUDE_MODEL=claude-opus-5-5
# low — быстро и дёшево; medium/high — вдумчивее, но медленнее и дороже
CLAUDE_EFFORT=low
GREETING=Здравствуйте! Напишите, пожалуйста, чем могу помочь 🙂
BUSINESS_FILE=business.md
DB_PATH=bot.db
